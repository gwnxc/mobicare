<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"  android:layout_marginHorizontal="4dp" app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">           <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="18dp">         <ImageView
    android:id="@+id/ivNotifIcon"
    android:layout_width="52dp"  android:layout_height="52dp"
    android:background="@drawable/circle_light_blue"
    android:padding="14dp"       android:src="@drawable/ic_notifications"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:tint="@color/trust_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginEnd="12dp"   android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@+id/ivUnreadDot"
        app:layout_constraintStart_toEndOf="@+id/ivNotifIcon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification Title"
            android:textColor="@color/slate_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNotifDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Description goes here."
            android:textColor="@color/cool_grey"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvNotifDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="2026-05-10"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/ivUnreadDot"
        android:layout_width="12dp"  android:layout_height="12dp"
        android:layout_marginEnd="4dp" android:background="@drawable/badge_blue_light"
        android:backgroundTint="#2196F3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>