<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavHealthWorkerCustom"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/pure_white"
    android:orientation="horizontal"
    android:elevation="16dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_nav_home"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            app:tint="@color/cool_grey" />
        <TextView
            android:id="@+id/tv_nav_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="11sp"
            android:textColor="@color/cool_grey" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_consultations_tab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_nav_consultations"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_consultation"
            app:tint="@color/cool_grey" />
        <TextView
            android:id="@+id/tv_nav_consultations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consultations"
            android:textSize="11sp"
            android:textColor="@color/cool_grey" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_add_record_tab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_nav_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_add"
            app:tint="@color/cool_grey" />
        <TextView
            android:id="@+id/tv_nav_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Record"
            android:textSize="11sp"
            android:textColor="@color/cool_grey" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_notifications_tab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_nav_alerts"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_notifications"
            app:tint="@color/cool_grey" />
        <TextView
            android:id="@+id/tv_nav_alerts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alerts"
            android:textSize="11sp"
            android:textColor="@color/cool_grey" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_profile_tab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_nav_profile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/cool_grey" />
        <TextView
            android:id="@+id/tv_nav_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="11sp"
            android:textColor="@color/cool_grey" />
    </LinearLayout>

</LinearLayout>