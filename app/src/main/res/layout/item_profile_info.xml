<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/ivInfoIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/circle_light_blue"
        android:padding="10dp"
        android:src="@drawable/ic_user"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/trust_blue" />

    <TextView
        android:id="@+id/tvInfoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Label"
        android:textStyle="bold"
        android:textColor="@color/slate_navy"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/ivInfoIcon"
        app:layout_constraintTop_toTopOf="@+id/ivInfoIcon" />

    <TextView
        android:id="@+id/tvInfoValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Value"
        android:textColor="#423F3F"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvInfoLabel"
        app:layout_constraintTop_toBottomOf="@+id/tvInfoLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>