<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivNotifIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_light_blue"
            android:padding="10dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#1976D2" />

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Notification Title"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvUnreadDot"
            app:layout_constraintStart_toEndOf="@+id/ivNotifIcon"
            app:layout_constraintTop_toTopOf="@+id/ivNotifIcon" />

        <TextView
            android:id="@+id/tvUnreadDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#1976D2"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNotifMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="This is the detailed message for the notification."
            android:textColor="#475569"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNotifTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvNotifTitle" />

        <TextView
            android:id="@+id/tvNotifDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2026-01-20"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@+id/tvNotifMessage"
            app:layout_constraintTop_toBottomOf="@+id/tvNotifMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>